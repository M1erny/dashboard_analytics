# Throwaway investigation scripts and downloaded source documents. Working
# files for a single question, not part of the dashboard — one is a 1.2 MB SEC
# filing that has no business in the history.
scratch/

# Dependencies and build output
node_modules/
dist/

# Python bytecode
__pycache__/
*.py[cod]

# Local secrets. README tells you to put them in backend/.env, so that file must
# never be committable: it holds the Supabase password and the Google API key.
# The .example templates stay tracked, they contain placeholders only.
.env
.env.*
!.env.example
!.env.*.example

# Local secrets. README tells you to put them in backend/.env, so that file must
# never be committable: it holds the Supabase password and the Google API key.
# The .example templates stay tracked, they contain placeholders only.
.env
.env.*
!.env.example
!.env.*.example

# Runtime artefacts: logs, debug dumps and the local database
*.log
debug_risk.txt
backend/debug_risk.txt
backend/brain.db
