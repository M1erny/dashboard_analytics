# Copy this file to backend/.env and fill in private values locally.
# backend/.env is gitignored.

# Required for the cloud dashboard to see the indexed brain.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Required for embeddings and Ask Brain generation.
GOOGLE_AI_API_KEY=your_google_ai_studio_key

# Your local synced Google Drive folder.
BRAIN_LOCAL_LIBRARY_DIR=C:\Users\YOUR_USER\My Drive (your_email@gmail.com)\Gielda

# Powerful local defaults. Lower these if your PC runs out of memory.
BRAIN_LOCAL_MAX_BYTES=262144000
BRAIN_LOCAL_MAX_PDF_PAGES=2000
BRAIN_LOCAL_MAX_EXTRACTED_CHARS=5000000

# Optional model choices.
BRAIN_LLM_MODEL=gemini-3.5-flash
BRAIN_EMBEDDING_MODEL=gemini-embedding-001
