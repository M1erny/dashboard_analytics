GOOGLE_AI_API_KEY=replace_with_google_ai_studio_key
BRAIN_LLM_MODEL=gemini-2.5-flash
BRAIN_EMBEDDING_MODEL=gemini-embedding-001

# Production brain storage. Use the Supabase/Postgres connection string, not the public project URL.
# Example shape:
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=replace_with_supabase_postgres_connection_string

# Google Drive API indexing. Client ID/secret come from a Google Cloud OAuth web app.
GOOGLE_DRIVE_FOLDER_ID=1DkFRs5oCdPt8j-3Z-vfR8BnG4y8Eqdc5
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
# Legacy callback /api/auth/google/callback is also supported.
GOOGLE_OAUTH_REDIRECT_URI=https://dashboard-eo6k.onrender.com/api/brain/drive/oauth/callback

# Optional for unattended Drive sync. If omitted, connect once through /api/brain/drive/auth-url.
# GOOGLE_DRIVE_REFRESH_TOKEN=replace_with_google_drive_refresh_token

# Optional: point at a Google Drive Desktop synced folder.
# BRAIN_LIBRARY_DIR=C:\Users\you\Google Drive\Investment Brain
