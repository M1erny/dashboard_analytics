GOOGLE_AI_API_KEY=replace_with_google_ai_studio_key
BRAIN_LLM_MODEL=gemini-3.7-flash
BRAIN_LLM_THINKING_LEVEL=minimal
BRAIN_EMBEDDING_MODEL=gemini-embedding-001

# Production brain storage. Use the Supabase/Postgres connection string, not the public project URL.
# Example shape:
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=replace_with_supabase_postgres_connection_string

# Google Drive API indexing. Client ID/secret come from a Google Cloud OAuth web app.
GOOGLE_DRIVE_FOLDER_ID=1DkFRs5oCdPt8j-3Z-vfR8BnG4y8Eqdc5
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
# Legacy callback /api/auth/google/callback is also supported.
GOOGLE_OAUTH_REDIRECT_URI=https://dashboard-eo6k.onrender.com/api/brain/drive/oauth/callback

# Optional for unattended Drive sync. If omitted, connect once through /api/brain/drive/auth-url.
# GOOGLE_DRIVE_REFRESH_TOKEN=replace_with_google_drive_refresh_token

# Optional: point at a Google Drive Desktop synced folder.
# BRAIN_LIBRARY_DIR=C:\Users\you\Google Drive\Investment Brain

# --- Ingestion limits ---------------------------------------------------------
# Extraction is unlimited by default: 0 means no limit, and there is no hidden
# ceiling overruling a larger value. Raising these is not normally needed.
# BRAIN_DRIVE_MAX_PDF_PAGES=0
# BRAIN_DRIVE_MAX_EXTRACTED_CHARS=0
# BRAIN_LOCAL_MAX_PDF_PAGES=0
# BRAIN_LOCAL_MAX_EXTRACTED_CHARS=0
#
# The per-file byte limit is the one real bound: the downloader holds the whole
# file in memory, so an unbounded download would take the instance down rather
# than skip one file. Files over it are reported by /api/brain/drive/coverage.
# BRAIN_DRIVE_MAX_BYTES=67108864
#
# Guards a malformed PDF from hanging the local worker. 0 disables it.
# BRAIN_PDF_EXTRACTION_TIMEOUT_SECONDS=600
#
# Raise if /api/brain/drive/coverage times out on a very large library.
# BRAIN_POSTGRES_STATEMENT_TIMEOUT_MS=12000

# --- Self-build: let the Brain write its own code -----------------------------
# A fine-grained GitHub personal access token scoped to this repository only,
# with Contents: read and write, and Pull requests: read and write. Nothing else.
# Without this token the self-build panel stays read-only.
# BRAIN_GITHUB_TOKEN=replace_with_fine_grained_github_token
# BRAIN_GITHUB_REPO=m1erny/dashboard_analytics
# BRAIN_GITHUB_BASE_BRANCH=main

# The coding model. Point this at the strongest model your Google AI Studio key
# has: writing TypeScript is much harder than answering a research question, so
# the Flash-Lite model used for Brain answers is the wrong tool here.
# BRAIN_CODE_MODEL=gemini-3.7-flash
# BRAIN_CODE_THINKING_LEVEL=high
# BRAIN_CODE_MAX_OUTPUT_TOKENS=32000
# BRAIN_CODE_TIMEOUT_SECONDS=240
# BRAIN_CODE_CONTEXT_FILES=8
# BRAIN_CODE_CONTEXT_CHARS=220000

# Refuse to open a new proposal while this many are already open.
# BRAIN_CODE_MAX_OPEN_PROPOSALS=5

# Off by default, and each one widens what a machine-written change can do.
# ALLOW_DEPENDENCIES lets it edit package.json / requirements.txt.
# ALLOW_SELF_EDIT lets it edit its own guardrail modules.
# ALLOW_MERGE adds a one-click merge button for green proposals in the dashboard.
# BRAIN_CODE_ALLOW_DEPENDENCIES=false
# BRAIN_CODE_ALLOW_SELF_EDIT=false
# BRAIN_CODE_ALLOW_MERGE=false
